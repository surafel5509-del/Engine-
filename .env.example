# Provider keys — keep server-side only.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# Agent runtime
FORGEAI_EXECUTION_MODE=disabled
FORGEAI_MAX_ITERATIONS=8
FORGEAI_WORKSPACE_ROOT=/tmp/forgeai-workspaces
FORGEAI_COMMAND_TIMEOUT_MS=120000
